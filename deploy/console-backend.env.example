# Shape only. The real values live in the CONSOLE_BACKEND_ENV repository
# secret.

POSTGRES_HOST=ep-fragrant-meadow-a57nihyk.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=console

# The console reads the orchestrator's LangGraph store directly, which lives
# in the nannos schema of the same database.
DOCSTORE_HOST=ep-fragrant-meadow-a57nihyk.us-east-2.aws.neon.tech
DOCSTORE_PORT=5432
DOCSTORE_DB=neondb
DOCSTORE_USER=neondb_owner
DOCSTORE_PASSWORD=

OIDC_ISSUER=https://13-48-218-238.sslip.io/auth/realms/nannos
OIDC_CLIENT_ID=agent-console
OIDC_CLIENT_SECRET=

ORCHESTRATOR_CLIENT_ID=orchestrator
ORCHESTRATOR_BASE_DOMAIN=orchestrator:10001
# Stays "local" even in production: app.py hardcodes the Socket.IO CORS
# allowlist per branch, and the nginx in front rewrites Origin to match this
# one. Any other value makes the websocket handshake fail.
ORCHESTRATOR_ENVIRONMENT=local

LLM_GATEWAY_URL=http://litellm:4000
LLM_GATEWAY_API_KEY=
# The console manages model deployments and reads the key from
# LITELLM_MASTER_KEY, not from LLM_GATEWAY_API_KEY. Same value, both needed.
LITELLM_MASTER_KEY=

OBJECT_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/data/storage
API_PORT=5001
LOG_LEVEL=INFO
LOG_MODE=JSON
