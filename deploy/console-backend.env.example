# Образец. Реальные значения — в секрете CONSOLE_BACKEND_ENV репозитория.

POSTGRES_HOST=ep-fragrant-meadow-a57nihyk.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=console

# Консоль читает хранилище оркестратора напрямую (схема nannos).
DOCSTORE_HOST=ep-fragrant-meadow-a57nihyk.us-east-2.aws.neon.tech
DOCSTORE_PORT=5432
DOCSTORE_DB=neondb
DOCSTORE_USER=neondb_owner
DOCSTORE_PASSWORD=

OIDC_ISSUER=https://13-48-218-238.sslip.io/auth/realms/nannos
OIDC_CLIENT_ID=agent-console
OIDC_CLIENT_SECRET=

ORCHESTRATOR_CLIENT_ID=orchestrator
ORCHESTRATOR_BASE_DOMAIN=orchestrator:10001
# Оставить local даже на сервере: список разрешённых источников для Socket.IO
# задан в app.py, и наш nginx подменяет Origin именно под эту ветку.
ORCHESTRATOR_ENVIRONMENT=local

LLM_GATEWAY_URL=http://litellm:4000
LLM_GATEWAY_API_KEY=
# Консоль управляет моделями и читает ключ именно отсюда, не из
# LLM_GATEWAY_API_KEY. Значение то же самое.
LITELLM_MASTER_KEY=

OBJECT_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/data/storage
API_PORT=5001
LOG_LEVEL=INFO
LOG_MODE=JSON
