# Shape only. The real values live in the ORCHESTRATOR_ENV repository secret
# and reach the machine through the deploy workflow.

POSTGRES_HOST=ep-fragrant-meadow-a57nihyk.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=nannos

OIDC_ISSUER=https://13-48-218-238.sslip.io/auth/realms/nannos
OIDC_CLIENT_ID=orchestrator
OIDC_CLIENT_SECRET=

LLM_GATEWAY_URL=http://litellm:4000
LLM_GATEWAY_API_KEY=

CONSOLE_BACKEND_URL=http://console-backend:5001
CONSOLE_FRONTEND_URL=https://13-48-218-238.sslip.io
AGENT_BASE_URL=http://orchestrator:10001

OBJECT_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/data/storage
LOG_LEVEL=INFO
LOG_MODE=JSON
LANGSMITH_TRACING=false

# The image defaults to 300 seconds, long enough that a stalled sub-agent
# looks like a hang rather than a failure.
SUBAGENT_STREAM_STALL_TIMEOUT_SECONDS=60
